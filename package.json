{
  "name": "dsh-context-cap",
  "version": "0.1.1",
  "description": "Composer control that caps the routed model's context window so automatic compaction fires earlier and long conversations stay cheap.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "context-window",
    "compaction",
    "usage"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mouse985/dsh-context-cap.git"
  },
  "homepage": "https://github.com/mouse985/dsh-context-cap#readme",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "assets",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
